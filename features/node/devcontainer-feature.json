{
    "id": "node",
    "version": "1.0.12",
    "name": "NodeJS",
    "description": "Install NodeJS",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "none"
            ],
            "default": "none",
            "description": "Select or enter a NodeJS version to install"
        }
    },
    "containerEnv": {
        "NPM_CONFIG_PREFIX": "/usr/local/npm",
        "PATH": "${PATH}:${NPM_CONFIG_PREFIX}/bin"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "biomejs.biome"
            ]
        }
    }
}
