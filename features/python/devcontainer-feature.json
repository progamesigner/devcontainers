{
    "id": "python",
    "version": "1.0.7",
    "name": "Python",
    "description": "Install Python",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "none"
            ],
            "default": "none",
            "description": "Select or enter a Python version to install"
        },
        "optimize": {
            "type": "boolean",
            "default": false,
            "description": "Optimize Python for performance when compiled (slow)"
        }
    },
    "containerEnv": {
        "UV_TOOL_DIR": "/usr/local/uv/tools",
        "UV_TOOL_BIN_DIR": "/usr/local/uv/bin",
        "PATH": "${PATH}:${UV_TOOL_BIN_DIR}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    }
}
