{
    "id": "docker",
    "version": "1.2.0",
    "name": "Docker Client & Docker Compose",
    "description": "Install Docker Client & Docker Compose",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "none"
            ],
            "default": "latest",
            "description": "Select or enter a docker client version to install"
        },
        "buildx": {
            "type": "string",
            "proposals": [
                "latest",
                "none"
            ],
            "default": "latest",
            "description": "Select or enter a docker-buildx version to install"
        },
        "compose": {
            "type": "string",
            "proposals": [
                "latest",
                "none"
            ],
            "default": "latest",
            "description": "Select or enter a docker-compose version to install"
        },
        "socketUser": {
            "type": "string",
            "proposals": [
                "automatic",
                "root",
                "vscode"
            ],
            "default": "automatic",
            "description": "Select the user granted access to the mounted docker socket"
        }
    },
    "containerEnv": {
        "DOCKER_BUILDKIT": "1"
    },
    "entrypoint": "/usr/local/share/docker-init.sh"
}
