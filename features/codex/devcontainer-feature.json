{
    "id": "codex",
    "version": "1.0.3",
    "name": "Codex",
    "description": "Install Codex",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "none"
            ],
            "default": "latest",
            "description": "Select or enter a Codex version to install"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/progamesigner/devcontainers/features/node"
    ],
    "containerEnv": {
        "PATH": "${PATH}:/usr/local/share/codex/bin"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt"
            ]
        }
    }
}
