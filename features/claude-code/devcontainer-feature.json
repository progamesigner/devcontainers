{
    "id": "claude-code",
    "version": "1.0.4",
    "name": "Claude Code",
    "description": "Install Claude Code",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "none"
            ],
            "default": "latest",
            "description": "Select or enter a Claude Code version to install"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/progamesigner/devcontainers/features/node"
    ],
    "containerEnv": {
        "PATH": "${PATH}:/usr/local/share/claude-code/bin"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "Anthropic.claude-code"
            ]
        }
    },
    "entrypoint": "/usr/local/share/claude-code-init.sh"
}
