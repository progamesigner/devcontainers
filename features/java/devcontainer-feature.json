{
    "id": "java",
    "version": "1.0.1",
    "name": "Java",
    "description": "Install Java",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "none"
            ],
            "default": "none",
            "description": "Select a JDK major (21) or exact Temurin release (21.0.9+10) to install"
        }
    },
    "containerEnv": {
        "JAVA_HOME": "/opt/java/temurin",
        "PATH": "${PATH}:/opt/java/temurin/bin"
    }
}
