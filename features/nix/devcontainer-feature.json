{
    "id": "nix",
    "version": "1.0.0",
    "name": "Nix",
    "description": "Install Nix and configure a dev.nix environment or flake devShell",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "none"
            ],
            "default": "latest",
            "description": "Select or enter a Nix version to install"
        },
        "file": {
            "type": "string",
            "default": ".devcontainer/dev.nix",
            "description": "Path to dev.nix or flake.nix, relative to the workspace folder",
            "proposals": [
                ".devcontainer/dev.nix",
                ".idx/dev.nix",
                "flake.nix"
            ]
        },
        "devShell": {
            "type": "string",
            "default": "default",
            "description": "Name of the devShell to load when the file is a flake.nix"
        },
        "channel": {
            "type": "string",
            "proposals": [
                "stable-26.05",
                "unstable"
            ],
            "default": "stable-26.05",
            "description": "Default nixpkgs channel for dev.nix: stable-<release>, unstable, a branch or a commit"
        },
        "allowUnfree": {
            "type": "boolean",
            "default": false,
            "description": "Allow packages with an unfree license in dev.nix"
        },
        "autoRebuild": {
            "type": "boolean",
            "default": true,
            "description": "Rebuild the environment on container start when the environment file, its flake.lock or the options changed since the last build"
        }
    },
    "containerEnv": {
        "NIX_SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt",
        "PATH": "/nix/var/devnix/profile/bin:/nix/var/nix/profiles/default/bin:${PATH}"
    },
    "mounts": [
        {
            "source": "nix-${devcontainerId}",
            "target": "/nix",
            "type": "volume"
        }
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "jnoortheen.nix-ide"
            ]
        }
    },
    "onCreateCommand": "/usr/local/bin/devnix build",
    "postCreateCommand": "/usr/local/bin/devnix run onCreate",
    "postStartCommand": "/usr/local/bin/devnix start"
}
